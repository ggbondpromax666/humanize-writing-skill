{
  "version": "1.0.0",
  "lang": "en",
  "note": "Candidate-signal corpus. Not a banned-word list: every entry carries a keep-condition. Add entries by copying an existing shape and running scripts/scan.py.",
  "entries": [
    {"id":"en-st-001","re":"\\b(in today'?s|in an?)\\s+(fast-paced|ever-changing|rapidly evolving|digital|modern|uncertain)\\b","show":"In today's fast-paced world","fam":"stock","sev":"strong","label":"world-staging opener","keep":"the background is the subject","fix":"open on the problem or a scene"},
    {"id":"en-st-002","re":"\\b(as we navigate|in the ever-evolving landscape|in an era of)\\b","show":"As we navigate the ever-evolving landscape of","fam":"stock","sev":"strong","label":"decorative grandeur","keep":"never as written","fix":"delete"},
    {"id":"en-st-003","re":"\\b(since the dawn of|throughout history|since time immemorial)\\b","show":"Since the dawn of time","fam":"stock","sev":"strong","label":"vague time claim","keep":"give a real period instead","fix":"name the period"},
    {"id":"en-st-004","re":"\\bit'?s no secret that\\b","show":"It's no secret that","fam":"stock","sev":"strong","label":"consensus as evidence","keep":"the consensus is contested","fix":"delete, or give evidence"},
    {"id":"en-st-005","re":"\\bin recent years,[^.]{0,40}(increasingly|has become|have become)\\b","show":"In recent years, X has become increasingly important","fam":"stock","sev":"strong","label":"importance asserted","keep":"there is a measurable trend","fix":"give the metric"},
    {"id":"en-st-006","re":"\\bwith the (rapid )?(development|advancement|growth) of\\b","show":"With the rapid development of","fam":"stock","sev":"strong","label":"fake causal opener","keep":"the trend is real and relevant","fix":"state the trend with data"},
    {"id":"en-st-007","re":"\\b(it'?s|it is)\\s+(worth|important)\\s+(noting|to note)\\b","show":"It's worth noting that","fam":"stock","sev":"strong","label":"paragraph opener, no referent","keep":"the point genuinely contradicts expectation","fix":"delete the frame, state the fact"},
    {"id":"en-st-008","re":"\\b(notably|importantly|crucially|interestingly|indeed)\\s*,","show":"Notably,","fam":"stock","sev":"strong","label":"adverb asserting significance","keep":"rarely","fix":"delete"},
    {"id":"en-st-009","re":"\\b(moreover|furthermore|additionally)\\s*,","show":"Moreover,","fam":"stock","sev":"weak","label":"connector stacking","keep":"a real logical addition","fix":"delete, let order do the work"},
    {"id":"en-st-010","re":"\\b(of course)\\s*,","show":"Of course,","fam":"stock","sev":"weak","label":"pre-empting an objection","keep":"a real concession follows","fix":"make the concession concrete"},
    {"id":"en-st-011","re":"\\b(in fact|actually)\\s*,","show":"In fact,","fam":"stock","sev":"weak","label":"implies the previous sentence was false","keep":"a real surface-vs-reality gap","fix":"state both sides"},
    {"id":"en-st-012","re":"\\b(here'?s the thing|the truth is|the reality is|let me be clear)\\b","show":"Here's the thing","fam":"stock","sev":"strong","label":"fake-insight setup","keep":"never","fix":"state the point"},
    {"id":"en-st-013","re":"\\b(what most people (get wrong|miss)|the part (everyone|nobody) (misses|tells you))\\b","show":"What most people get wrong","fam":"stock","sev":"strong","label":"faux-insight setup","keep":"never","fix":"make the claim stand alone"},
    {"id":"en-st-014","re":"\\b(the uncomfortable truth|it turns out that)\\b","show":"The uncomfortable truth is","fam":"stock","sev":"strong","label":"staged candor / fake discovery","keep":"a real finding with a source","fix":"state the claim, give the source"},
    {"id":"en-st-015","re":"\\b(isn'?t|is not|not)\\s+(just\\s+)?(about\\s+)?\\w+[,;:]?\\s*(it'?s|but)\\b","show":"It's not just X, it's Y","fam":"stock","sev":"strong","label":"binary contrast","keep":"X is a real misconception the reader holds","fix":"state Y only"},
    {"id":"en-st-016","re":"\\b(less about|more about)\\b","show":"Less about X, more about Y","fam":"stock","sev":"strong","label":"binary contrast","keep":"a real trade-off exists","fix":"give the trade-off conditions"},
    {"id":"en-st-017","re":"\\b(not only)\\b[^.]{0,60}\\b(but also)\\b","show":"Not only X but also Y","fam":"stock","sev":"weak","label":"mechanical escalation","keep":"both clauses factual and distinct","fix":"split into two sentences"},
    {"id":"en-st-018","re":"\\bthe question isn'?t\\b[^.]{0,40}\\bit'?s\\b","show":"The question isn't X, it's Y","fam":"stock","sev":"strong","label":"reframe without evidence","keep":"you show why X fails","fix":"show it, or state Y"},
    {"id":"en-st-019","re":"\\b(plays?|played|playing)\\s+(a\\s+)?(crucial|vital|pivotal|key|critical|significant)\\s+role\\b","show":"plays a crucial role","fam":"stock","sev":"strong","label":"importance inflation","keep":"never as a phrase","fix":"say what it does"},
    {"id":"en-st-020","re":"\\b(serves? as a testament|stands? as a testament|a testament to|testament to)\\b","show":"serves as a testament to","fam":"stock","sev":"strong","label":"testament puffery","keep":"never","fix":"delete"},
    {"id":"en-st-021","re":"\\b(mark(s|ed|ing)? a (pivotal|turning|crucial) moment|paves? the way for|solidifies?)\\b","show":"marks a pivotal moment","fam":"stock","sev":"strong","label":"historical/forward inflation","keep":"a verifiable turning point","fix":"state the event"},
    {"id":"en-st-022","re":"\\b(underscor(e|es|ing)|highlight(s|ing)?|reflect(s|ing)?)\\s+(the|its)\\s+(\\w+\\s+){0,2}(importance|significance|commitment|value)\\b","show":"underscores its importance","fam":"stock","sev":"strong","label":"trailing significance rider","keep":"the source itself says this","fix":"keep the fact, cut the rider"},
    {"id":"en-st-023","re":"\\b(has become an integral part of|an integral part of)\\b","show":"has become an integral part of","fam":"stock","sev":"strong","label":"vague integration","keep":"specific date and mechanism","fix":"say when and how"},
    {"id":"en-st-024","re":"\\bexperts (agree|say|believe|note)\\b","show":"Experts agree","fam":"stock","sev":"strong","label":"unnamed authority","keep":"a named expert exists","fix":"name them"},
    {"id":"en-st-025","re":"\\b(studies show|research suggests|research shows|evidence suggests)\\b","show":"Studies show","fam":"stock","sev":"strong","label":"source-free science","keep":"the user supplied the study","fix":"cite author, year, journal"},
    {"id":"en-st-026","re":"\\b(industry reports?|a recent (report|study|survey)|sources say|according to industry sources)\\b","show":"Industry reports indicate","fam":"stock","sev":"strong","label":"fake provenance","keep":"a real named report","fix":"name it; otherwise delete"},
    {"id":"en-st-027","re":"\\bit (has been|is) (said|widely believed|widely regarded)\\b","show":"It is widely believed","fam":"stock","sev":"strong","label":"passive attribution","keep":"a real attributable quote","fix":"attribute or delete"},
    {"id":"en-st-028","re":"\\b(critics|observers|analysts) have (noted|argued|cited)\\b","show":"Critics have noted","fam":"stock","sev":"strong","label":"unnamed critics","keep":"named critics","fix":"name them"},
    {"id":"en-st-029","re":"\\bto some extent\\b|\\bin some ways\\b","show":"To some extent","fam":"stock","sev":"strong","label":"hedge without referent","keep":"a real boundary follows","fix":"give the boundary"},
    {"id":"en-st-030","re":"\\b(arguably|generally speaking|for the most part|in many cases)\\b","show":"Arguably","fam":"stock","sev":"weak","label":"softening with no scope","keep":"a real exception exists","fix":"give the exception"},
    {"id":"en-st-031","re":"\\bthis may or may not\\b","show":"This may or may not be the case","fam":"stock","sev":"strong","label":"contentless hedge","keep":"never","fix":"delete"},
    {"id":"en-st-032","re":"\\b(in this (article|section|piece)|this (article|section) (will|covers))\\b","show":"In this article, we will","fam":"stock","sev":"strong","label":"navigation instead of content","keep":"required by the format","fix":"delete; headings suffice"},
    {"id":"en-st-033","re":"\\b(let'?s (dive|explore|break|unpack)|without further ado|here'?s what you need to know)\\b","show":"Let's dive in","fam":"stock","sev":"strong","label":"run-up","keep":"never","fix":"delete"},
    {"id":"en-st-034","re":"\\b(as mentioned (earlier|above)|as we saw (above|earlier))\\b","show":"As mentioned earlier","fam":"stock","sev":"weak","label":"re-anchoring","keep":"long document, one use","fix":"keep one; point specifically otherwise"},
    {"id":"en-st-035","re":"\\b(in other words|put simply|simply put|that is to say)\\b","show":"In other words","fam":"stock","sev":"strong","label":"metadiscourse restatement","keep":"the second version is genuinely clearer","fix":"keep the clearer one, delete the frame"},
    {"id":"en-st-036","re":"\\b(in conclusion|in summary|to sum up|ultimately)\\b","show":"In conclusion","fam":"stock","sev":"strong","label":"recap closer","keep":"a long report needing a summary","fix":"delete"},
    {"id":"en-st-037","re":"\\b(at the end of the day|when all is said and done)\\b","show":"At the end of the day","fam":"stock","sev":"strong","label":"filler","keep":"never","fix":"delete"},
    {"id":"en-st-038","re":"\\b(the future looks bright|only time will tell|the possibilities are endless|this is just the beginning)\\b","show":"The future looks bright","fam":"stock","sev":"strong","label":"uplift closer","keep":"concrete plans exist","fix":"state the plans"},
    {"id":"en-st-039","re":"\\b(let'?s wait and see|exciting times (lie )?ahead)\\b","show":"Exciting times ahead","fam":"stock","sev":"strong","label":"empty send-off","keep":"never","fix":"delete"},
    {"id":"en-st-040","re":"\\b(what if I told you|think about it|consider this)\\b","show":"What if I told you","fam":"stock","sev":"weak","label":"manufactured suspense","keep":"a speaking script","fix":"state the fact"},
    {"id":"en-st-041","re":"\\b(plot twist|but here'?s the catch|the result\\?|sound familiar\\?)\\b","show":"But here's the catch","fam":"stock","sev":"weak","label":"entertainment cadence","keep":"never in expository prose","fix":"state the caveat"},
    {"id":"en-st-042","re":"\\b(serves? as|functions? as|acts? as|represents?)\\b","show":"serves as","fam":"stock","sev":"weak","label":"weak verb","keep":"a genuine role distinction","fix":"is / has / the specific verb"},
    {"id":"en-st-043","re":"\\b(boasts?|features?|offers?|maintains?)\\s+(a|an|over|more than)\\b","show":"boasts over 3,000 square feet","fam":"stock","sev":"weak","label":"promotional verb","keep":"a product page","fix":"has, or the specific verb"},
    {"id":"en-st-044","re":"\\b(highlighting|underscoring|emphasizing|reflecting|showcasing|symbolizing|ensuring|fostering|contributing to)\\b","show":"highlighting the team's commitment","fam":"stock","sev":"weak","label":"shallow -ing rider","keep":"the source supports the claim the rider makes","fix":"convert to a finite verb or delete"},
    {"id":"en-st-045","re":"\\b(nestled in the heart of|rich cultural heritage|stunning natural beauty|breathtaking|must-visit|a hidden gem|world-class)\\b","show":"nestled in the heart of","fam":"stock","sev":"strong","label":"sales language","keep":"never","fix":"state what the thing is"},
    {"id":"en-st-046","re":"\\b(delve|tapestry|realm|leverage|seamless|pivotal|meticulous|intricate|multifaceted|foster|embark|unleash|harness|elevate|empower|streamline|cutting-edge|paradigm shift|game changer|transformative|holistic|synergy|ever-evolving|unprecedented|supercharge|reimagine|revolutionize)\\b","show":"delve / tapestry / seamless","fam":"stock","sev":"weak","label":"AI-favored vocabulary","keep":"check density; one word is not a tell","fix":"replace with the plain word, or keep if technical"},

    {"id":"en-df-001","re":"\\b(just my two cents|still has (many )?limitations|for reference only|a modest attempt)\\b","show":"still has many limitations","fam":"defensive","sev":"strong","label":"unearned self-deprecation","keep":"a real limit, stated as scope","fix":"delete; convert real limits to scope"},
    {"id":"en-df-002","re":"\\b(let me be honest|i'?ll be honest|to be frank)\\b","show":"Let me be honest","fam":"defensive","sev":"strong","label":"performed candor","keep":"the disclosed weakness itself","fix":"delete the posture, keep the disclosure"},
    {"id":"en-df-003","re":"\\b(as of my last (update|training)|public information is (limited|scarce)|information is scarce|available sources are limited)\\b","show":"As of my last update","fam":"defensive","sev":"strong","label":"knowledge-cutoff disclaimer","keep":"a dated source instead","fix":"delete the sentence"},
    {"id":"en-df-004","re":"\\b(compiled by AI|unverified items are (flagged|marked)|your meaning has been preserved|no facts were changed)\\b","show":"unverified items are flagged","fam":"defensive","sev":"strong","label":"process narration","keep":"only what changes the reader's next action","fix":"delete"},
    {"id":"en-df-005","re":"\\b(it could (potentially )?(possibly )?be argued|could potentially|might arguably)\\b","show":"It could potentially possibly be argued","fam":"defensive","sev":"strong","label":"stacked hedges","keep":"one layer of real doubt","fix":"state the claim and its source of uncertainty"},
    {"id":"en-df-006","re":"\\b(i'?m not saying|that'?s not to say|don'?t get me wrong|to be clear,? i am not)\\b","show":"I'm not saying","fam":"defensive","sev":"strong","label":"strawman rebuttal","keep":"the objection appears in the text","fix":"delete the defense, state the claim"},
    {"id":"en-df-007","re":"\\b(there are (both )?(pros and cons|advantages and disadvantages)|it depends on many factors|everything has trade-offs)\\b","show":"There are pros and cons","fam":"defensive","sev":"strong","label":"stance vacuum","keep":"the conditions are named","fix":"name the conditions or the judgment"},
    {"id":"en-df-008","re":"\\b(you'?re on the right track|don'?t worry|you'?ve got this|a great start)\\b","show":"You're on the right track","fam":"defensive","sev":"strong","label":"reassurance / direction-granting","keep":"never","fix":"delete, or say the information is insufficient"},
    {"id":"en-df-009","re":"\\b(great question|certainly!|of course!|i hope this helps|let me know if you'?d like)\\b","show":"Great question!","fam":"defensive","sev":"strong","label":"chatbot wrapper","keep":"a real email greeting","fix":"delete"},
    {"id":"en-df-010","re":"\\b(this is a common mistake|many people misunderstand|most beginners get this wrong)\\b","show":"Many people misunderstand","fam":"defensive","sev":"weak","label":"flattering the writer","keep":"evidence about the audience exists","fix":"state the point without the setup"},

    {"id":"en-ex-001","re":"\\b(this (means|shows|demonstrates|suggests) that)\\b","show":"This shows that","fam":"explanatory","sev":"strong","label":"judgment on the reader's behalf","keep":"the inference is not obvious","fix":"delete; let facts carry it"},
    {"id":"en-ex-002","re":"\\b(the (key|main|important) (point|takeaway) is)\\b","show":"The key point is","fam":"explanatory","sev":"strong","label":"signposting the obvious","keep":"never","fix":"delete"},
    {"id":"en-ex-003","re":"\\b(here'?s a quick example|let me give you an example|for instance, consider)\\b","show":"Here's a quick example","fam":"explanatory","sev":"weak","label":"example announcement","keep":"never","fix":"just give the example"},
    {"id":"en-ex-004","re":"\\b(that last part matters|this distinction matters|as you can see)\\b","show":"That last part matters","fam":"explanatory","sev":"strong","label":"telling the reader what to notice","keep":"never","fix":"delete, or add the missing support"},
    {"id":"en-ex-005","re":"\\b(what this (shows|tells us) is)\\b","show":"What this shows is","fam":"explanatory","sev":"strong","label":"explaining the example","keep":"the example is genuinely ambiguous","fix":"delete the gloss"},
    {"id":"en-ex-006","re":"\\b(in layman'?s terms|to put it another way|in plain english)\\b","show":"In layman's terms","fam":"explanatory","sev":"weak","label":"pre-emptive simplification","keep":"the audience genuinely lacks the term","fix":"use the plain version directly"},

    {"id":"en-ct-001","re":"\\bthe [A-Z][A-Za-z]+ (framework|model|effect|method|principle|matrix)\\b","show":"the SCALE framework","fam":"coined","sev":"weak","label":"framework name (verify origin)","keep":"proposer and source can be named","fix":"check proposer and source; if untraceable, mark [verify]"},
    {"id":"en-ct-002","re":"\\b([A-Z]{2,6})\\s+(model|framework|method|principle)\\b","show":"the 3E model","fam":"coined","sev":"weak","label":"unexpanded acronym + label","keep":"expanded at first use","fix":"expand at first use; if it cannot be expanded, it is empty"},
    {"id":"en-ct-003","re":"\\b(a (leading|major|top|recent) (research institute|industry report|white paper|study by))\\b","show":"a leading research institute's report","fam":"coined","sev":"strong","label":"fake institution / report","keep":"named institution and link","fix":"delete or mark [needs source]; never invent one"},
    {"id":"en-ct-004","re":"\\b(hyper-?automation|value anchor|growth flywheel|operating model|synergy layer|enablement fabric|data-driven ecosystem)\\b","show":"growth flywheel","fam":"coined","sev":"weak","label":"empty abstraction","keep":"agent, object, and measurable result present","fix":"replace with who did what; else delete"},
    {"id":"en-ct-005","re":"\\b([a-z]+-(native|driven|first|centric|ready) [a-z]+ (ecosystem|platform|fabric|layer|stack))\\b","show":"AI-native data-driven ecosystem","fam":"coined","sev":"weak","label":"concept mashup","keep":"each half carries evidence","fix":"split; keep the half with evidence"},
    {"id":"en-ct-006","re":"\\b(the (\\w+ )?(entropy|paradigm|algorithm|bandwidth))\\b","show":"high entropy","fam":"coined","sev":"weak","label":"term drift (verify sense)","keep":"used in its technical sense","fix":"restore the real sense, or use a plain word"},
    {"id":"en-ct-007","re":"\\b(proven|widely adopted|industry-standard|best-in-class)\\b","show":"industry-standard","fam":"coined","sev":"weak","label":"borrowed authority on a term","keep":"a source supports the claim","fix":"delete, or cite"},

    {"id":"en-st-047","re":"\\b(in the world of|in the field of|in the space of)\\b","show":"In the world of","fam":"stock","sev":"strong","label":"field-staging frame","keep":"never","fix":"state the subject directly"},
    {"id":"en-st-048","re":"\\bwhen it comes to\\b","show":"When it comes to","fam":"stock","sev":"weak","label":"circumlocution","keep":"a genuine contrast follows","fix":"name the subject"},
    {"id":"en-st-049","re":"\\bat its core\\b|\\bin essence\\b|\\bfundamentally\\b","show":"At its core","fam":"stock","sev":"strong","label":"depth claim","keep":"a real distinction is being drawn","fix":"state the claim"},
    {"id":"en-st-050","re":"\\bthe fact that\\b","show":"the fact that","fam":"stock","sev":"weak","label":"nominal filler","keep":"never","fix":"drop it and keep the clause"},
    {"id":"en-st-051","re":"\\b(it is|it'?s) important to remember\\b","show":"It's important to remember","fam":"stock","sev":"strong","label":"importance instruction","keep":"never","fix":"delete"},
    {"id":"en-st-052","re":"\\bneedless to say\\b|\\bit goes without saying\\b","show":"Needless to say","fam":"stock","sev":"strong","label":"self-cancelling preface","keep":"never","fix":"delete"},
    {"id":"en-st-053","re":"\\bas a matter of fact\\b","show":"As a matter of fact","fam":"stock","sev":"strong","label":"emphasis filler","keep":"never","fix":"delete"},
    {"id":"en-st-054","re":"\\bin order to\\b","show":"in order to","fam":"stock","sev":"weak","label":"wordy infinitive","keep":"never","fix":"to"},
    {"id":"en-st-055","re":"\\bdue to the fact that\\b","show":"due to the fact that","fam":"stock","sev":"strong","label":"wordy causal","keep":"never","fix":"because"},
    {"id":"en-st-056","re":"\\ba wide range of\\b|\\ba variety of\\b","show":"a wide range of","fam":"stock","sev":"weak","label":"unspecified quantity","keep":"the range matters and is specified","fix":"name two or three, or give the count"},
    {"id":"en-st-057","re":"\\bvarious aspects of\\b|\\bmultiple facets of\\b","show":"various aspects of","fam":"stock","sev":"weak","label":"unspecified scope","keep":"the aspects are named","fix":"name them"},
    {"id":"en-st-058","re":"\\bthe realm of\\b|\\bthe landscape of\\b","show":"the realm of","fam":"stock","sev":"strong","label":"abstract territory","keep":"never","fix":"say what it is"},
    {"id":"en-st-059","re":"\\b(navigate|navigating) the (complexities|complexity|challenges)\\b","show":"navigate the complexities","fam":"stock","sev":"strong","label":"journey metaphor","keep":"never","fix":"name the specific difficulty"},
    {"id":"en-st-060","re":"\\bunlock(s|ing)? the (potential|power|value)\\b","show":"unlock the potential","fam":"stock","sev":"strong","label":"marketing abstraction","keep":"never","fix":"say what becomes possible"},
    {"id":"en-st-061","re":"\\bpaves? the way for\\b","show":"paves the way for","fam":"stock","sev":"strong","label":"forward inflation","keep":"a documented causal link","fix":"state the link or delete"},
    {"id":"en-st-062","re":"\\bshed(s|ding)? light on\\b","show":"sheds light on","fam":"stock","sev":"weak","label":"metaphor for evidence","keep":"rarely","fix":"say what was found"},
    {"id":"en-st-063","re":"\\ba double-edged sword\\b","show":"a double-edged sword","fam":"stock","sev":"strong","label":"cliché metaphor","keep":"never","fix":"state both sides"},
    {"id":"en-st-064","re":"\\bthe tip of the iceberg\\b","show":"the tip of the iceberg","fam":"stock","sev":"strong","label":"cliché metaphor","keep":"never","fix":"say what is hidden and how much"},
    {"id":"en-st-065","re":"\\ba game-?changer\\b|\\bchanges everything\\b","show":"a game-changer","fam":"stock","sev":"strong","label":"hype","keep":"never","fix":"say what changed"},
    {"id":"en-st-066","re":"\\bbridge(s|d)? the gap\\b","show":"bridge the gap","fam":"stock","sev":"weak","label":"metaphor","keep":"the gap is defined","fix":"name the two sides and the gap"},
    {"id":"en-st-067","re":"\\bmove(s|d)? the needle\\b","show":"move the needle","fam":"stock","sev":"weak","label":"corporate metaphor","keep":"a metric is named","fix":"name the metric and the change"},
    {"id":"en-st-068","re":"\\bat scale\\b|\\bat enterprise scale\\b","show":"at scale","fam":"stock","sev":"weak","label":"unspecified scale","keep":"a number follows","fix":"give the number"},
    {"id":"en-st-069","re":"\\bbest practices?\\b","show":"best practices","fam":"stock","sev":"weak","label":"appeal to convention","keep":"the source of the practice is named","fix":"say who says so and why"},
    {"id":"en-st-070","re":"\\bactionable insights?\\b|\\bkey takeaways?\\b","show":"actionable insights","fam":"stock","sev":"strong","label":"deliverable inflation","keep":"never","fix":"state the insight"},
    {"id":"en-st-071","re":"\\bdeep dive\\b|\\bdeep-dive\\b","show":"deep dive","fam":"stock","sev":"weak","label":"content announcement","keep":"never","fix":"just do it"},
    {"id":"en-st-072","re":"\\ballow me to\\b|\\bi'?d like to (take a moment|share)\\b","show":"Allow me to","fam":"stock","sev":"strong","label":"ceremonial preface","keep":"a real speech","fix":"delete"},
    {"id":"en-st-073","re":"\\bthe bottom line is\\b","show":"The bottom line is","fam":"stock","sev":"weak","label":"summary marker","keep":"a long argument is closing","fix":"state it"},
    {"id":"en-st-074","re":"\\bwhen it comes down to it\\b","show":"When it comes down to it","fam":"stock","sev":"strong","label":"filler","keep":"never","fix":"delete"},
    {"id":"en-st-075","re":"\\bit'?s (also )?worth mentioning\\b","show":"It's also worth mentioning","fam":"stock","sev":"strong","label":"additive importance sticker","keep":"never","fix":"delete"},
    {"id":"en-st-076","re":"\\b(this is|that'?s) where .{0,20} comes in\\b","show":"This is where X comes in","fam":"stock","sev":"strong","label":"staged entrance","keep":"never","fix":"state the role"},
    {"id":"en-st-077","re":"\\bwhether you'?re a .{0,30} or a\\b","show":"Whether you're a beginner or an expert","fam":"stock","sev":"strong","label":"audience-spanning trope","keep":"the advice actually differs by audience","fix":"pick the reader"},
    {"id":"en-st-078","re":"\\bfrom (beginners|novices) to (experts|professionals)\\b","show":"from beginners to experts","fam":"stock","sev":"strong","label":"audience-spanning trope","keep":"never","fix":"pick the reader"},
    {"id":"en-st-079","re":"\\bthe world of .{0,30} is (changing|evolving)\\b","show":"The world of X is changing","fam":"stock","sev":"strong","label":"change assertion without content","keep":"a specific change is named","fix":"name the change"},
    {"id":"en-st-080","re":"\\bhere'?s (a|the) (simple|quick) (truth|rule|framework)\\b","show":"Here's the simple truth","fam":"stock","sev":"strong","label":"formula tease","keep":"never","fix":"state it"},

    {"id":"en-df-011","re":"\\b(that said|having said that)\\b","show":"That said,","fam":"defensive","sev":"weak","label":"hedged pivot","keep":"a real reversal follows","fix":"state the reversal"},
    {"id":"en-df-012","re":"\\bi (could|may) be wrong,? but\\b","show":"I could be wrong, but","fam":"defensive","sev":"strong","label":"pre-emptive disclaimer","keep":"the writer is genuinely uncertain","fix":"delete; state the uncertainty once"},
    {"id":"en-df-013","re":"\\b(this is not (a )?(definitive|complete|exhaustive))\\b","show":"This is not a definitive answer","fam":"defensive","sev":"strong","label":"scope disclaiming","keep":"the reader needs the boundary","fix":"give the actual scope"},
    {"id":"en-df-014","re":"\\bresults may vary\\b|\\byour mileage may vary\\b","show":"Results may vary","fam":"defensive","sev":"weak","label":"generic caveat","keep":"variation is documented","fix":"say how it varies"},
    {"id":"en-df-015","re":"\\b(no|there are no) guarantees?\\b","show":"no guarantees","fam":"defensive","sev":"weak","label":"liability shield","keep":"legal context","fix":"state the actual risk"},
    {"id":"en-df-016","re":"\\b(please )?consult (a|your) (professional|doctor|lawyer|advisor)\\b","show":"consult a professional","fam":"defensive","sev":"weak","label":"liability disclaimer","keep":"genuinely required","fix":"keep once; add the specific reason"},
